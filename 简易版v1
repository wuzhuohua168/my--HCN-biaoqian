<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>物流标签生成器-无空白页完美版</title>

<script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.1/build/qrcode.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/html2pdf.js@0.10.1/dist/html2pdf.bundle.min.js"></script>

<style>
    /* 极致清除任何干扰边距 */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body { font-family: -apple-system, sans-serif; background-color: #f4f7f9; padding: 10px; }
    
    #container { 
        width: 100%; 
        max-width: 100mm; 
        margin: 0 auto; 
    }

    /* 关键修复：page-wrapper 必须精准锁定，禁止任何溢出 */
    .page-wrapper {
        width: 100mm;
        height: 100mm;
        background: white;
        overflow: hidden; /* 核心：防止微小像素溢出导致空白页 */
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
        /* 仅在预览时显示边距 */
    }

    .label {
        width: 100mm;
        height: 98.5mm; /* 进一步压缩高度，预留 1.5mm 的绝对安全区 */
        padding: 6mm; 
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        background: white;
    }

    /* 内部排版保持 */
    .top-section { width: 100%; height: 40%; flex-shrink: 0; }
    .header { 
        text-align: center; font-size: 24px; font-weight: bold; 
        border-bottom: 4px solid #000; padding-bottom: 2mm; margin-bottom: 2mm;
    }
    .seq-info { text-align: center; flex: 1; display: flex; flex-direction: column; justify-content: center; }
    .seq { font-size: 48px; font-weight: 900; line-height: 1; }
    .tracking-text { font-size: 16px; font-family: monospace; font-weight: bold; margin-top: 2mm; }
    
    .qr-area { width: 100%; height: 38%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
    .qr-area canvas { height: 100% !important; width: auto !important; }

    .bottom-section { width: 100%; height: 18%; flex-shrink: 0; display: flex; align-items: flex-end; }
    .made { width: 100%; border: 4px solid #000; text-align: center; font-size: 20px; font-weight: bold; padding: 1.5mm; }

    /* 控制面板 */
    .controls { 
        width: 100%; max-width: 450px; margin: 0 auto 20px; background: #fff; 
        padding: 15px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.06);
    }
    .input-row { display: flex; flex-direction: column; margin-bottom: 12px; gap: 5px; }
    .input-row label { font-size: 13px; font-weight: bold; color: #666; }
    .input-row select, .input-row input { 
        width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 8px; font-size: 16px; 
    }
    .btn-group { display: flex; gap: 10px; margin-top: 5px; }
    button { flex: 1; padding: 15px; border: none; border-radius: 10px; font-weight: bold; color: white; }
    .btn-gen { background: #4a90e2; }
    .btn-share { background: #f5a623; } 

    /* 移动端预览适配：PDF导出时不生效 */
    @media screen {
        #container { width: 100%; }
        .page-wrapper { 
            width: 100%; height: auto; aspect-ratio: 1/1; 
            margin-bottom: 10px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); 
        }
        .label { width: 100%; height: 100%; padding: 5%; }
    }
</style>
</head>

<body>

<div class="controls no-print">
    <div class="input-row">
        <label>运输方式</label>
        <select id="mode">
            <option>大陆飞日本</option><option>香港飞日本</option><option>国际快递</option>
            <option>普船海运GS</option><option>普船海运包税</option><option>快船包税</option>
            <option>普船商业件</option><option>快船商业件</option>
            <option>20呎整柜商业件</option><option>40呎整柜商业件</option>
            <option>20呎整柜亚马逊件</option><option>40呎整柜亚马逊件</option>
        </select>
    </div>
    <div class="input-row"><label>单号前缀</label><input type="text" id="prefix" value="HCN"></div>
    <div class="input-row"><label>生成件数</label><input type="number" id="qty" value="3" min="1"></div>
    <div class="btn-group">
        <button class="btn-gen" onclick="handleGenerate()">1. 生成预览</button>
        <button class="btn-share" onclick="handleShare()">2. 分享 PDF</button>
    </div>
</div>

<div id="container"></div>

<script>
let firstTrackingNo = ""; 
let currentModeText = "";

function randomTracking(prefix) {
    const date = new Date().toISOString().slice(2,10).replace(/-/g,"");
    const rand = Math.floor(Math.random() * 100000).toString().padStart(5, "0");
    return prefix + date + rand;
}

async function handleGenerate() {
    const total = parseInt(document.getElementById("qty").value);
    const prefix = document.getElementById("prefix").value || "CN";
    const modeSelect = document.getElementById("mode");
    currentModeText = modeSelect.options[modeSelect.selectedIndex].text;
    
    const container = document.getElementById("container");
    container.innerHTML = "<p style='text-align:center; padding:20px;'>生成高清标签中...</p>";

    const fragments = document.createDocumentFragment();

    for (let i = 1; i <= total; i++) {
        const tracking = randomTracking(prefix);
        if (i === 1) firstTrackingNo = tracking;

        const wrapper = document.createElement('div');
        wrapper.className = 'page-wrapper';
        wrapper.innerHTML = `
            <div class="label">
                <div class="top-section">
                    <div class="header" style="${currentModeText.length > 8 ? 'font-size: 18px;' : ''}">${currentModeText}</div>
                    <div class="seq-info">
                        <div class="seq">${i} / ${total}</div>
                        <div class="tracking-text">${tracking}</div>
                    </div>
                </div>
                <div class="qr-area"><canvas id="qr${i}"></canvas></div>
                <div class="bottom-section"><div class="made">MADE IN CHINA</div></div>
            </div>
        `;
        fragments.appendChild(wrapper);
    }

    container.innerHTML = "";
    container.appendChild(fragments);

    for (let i = 1; i <= total; i++) {
        const trackingEl = document.querySelectorAll('.tracking-text')[i-1];
        const qrData = `单号:${trackingEl.innerText}\n方式:${currentModeText}\n件数:${i}/${total}`;
        await QRCode.toCanvas(document.getElementById(`qr${i}`), qrData, {
            width: 280, margin: 1, errorCorrectionLevel: 'H'
        });
    }
}

async function handleShare() {
    const container = document.getElementById("container");
    if (container.children.length === 0) { alert("请先生成预览！"); return; }

    const qty = document.getElementById("qty").value;
    const safeMode = currentModeText.replace(/[呎\/\\:\*\?"<>\|]/g, "");
    const fileName = `${safeMode}_${firstTrackingNo}_${qty}PCS.pdf`;

    const opt = {
        margin: 0,
        filename: fileName,
        image: { type: 'jpeg', quality: 1.0 },
        html2canvas: { 
            scale: 2, /* 降低一点缩放倍数提高移动端稳定性 */
            useCORS: true, 
            scrollY: 0, 
            scrollX: 0,
            windowWidth: 378, /* 强制以100mm的像素宽度渲染 */
            letterRendering: true
        },
        jsPDF: { unit: 'mm', format: [100, 100], orientation: 'portrait' },
        pagebreak: { mode: 'avoid-all', before: '.page-wrapper' } /* 极致分页避免模式 */
    };

    try {
        const pdfBlob = await html2pdf().set(opt).from(container).output('blob');
        const file = new File([pdfBlob], fileName, { type: "application/pdf" });

        if (navigator.canShare && navigator.canShare({ files: [file] })) {
            await navigator.share({ files: [file], title: '物流标签' });
        } else {
            const link = document.createElement('a');
            link.href = URL.createObjectURL(pdfBlob);
            link.download = fileName;
            link.click();
        }
    } catch (err) {
        alert("分享失败，建议在手机浏览器中打开。");
    }
}
</script>
</body>
</html>
